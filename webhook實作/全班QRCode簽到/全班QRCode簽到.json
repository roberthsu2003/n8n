      "parameters": {
        "jsCode": "// 老師看板：產生簽到 QR Code + 今天的簽到名單（每 5 秒自動重新整理）\nconst cfg = $('設定').first().json;\nconst req = $('老師簽到看板').first().json;\nconst host  = (req.headers['x-forwarded-host'] || req.headers.host || '').split(',')[0];\nconst proto = (req.headers['x-forwarded-proto'] || (/^(localhost|127\\.)/.test(host) ? 'http' : 'https')).split(',')[0];\nconst checkinUrl = `${proto}://${host}/webhook/checkin`;\nconst qr = 'https://quickchart.io/qr?size=360&margin=1&text=' + encodeURIComponent(checkinUrl);\n\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\n// DataTable 沒有資料時會輸出一筆空資料（Always Output Data），要先過濾掉\nconst rows = $input.all().map(i => i.json).filter(r => r.student_id);\n\nconst list = rows.map((r, i) => `\n  <tr><td>${i + 1}</td><td>${esc(r.student_id)}</td><td>${esc(r.name)}</td><td>${esc(r.checkin_time)}</td></tr>`).join('');\n\nconst html = `<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"refresh\" content=\"5\">\n<title>簽到看板</title><style>\nbody{margin:0;font-family:-apple-system,'Segoe UI','Microsoft JhengHei',Arial,sans-serif;background:#0f172a;color:#f8fafc;padding:24px}\n.wrap{display:flex;gap:32px;flex-wrap:wrap;justify-content:center;align-items:flex-start}\n.qr{background:#fff;padding:20px;border-radius:24px;text-align:center;color:#0f172a}\n.qr img{width:min(360px,80vw);height:auto}\n.count{font-size:96px;font-weight:800;line-height:1;color:#facc15}\ntable{border-collapse:collapse;min-width:min(420px,90vw);font-size:18px}\ntd,th{padding:8px 12px;border-bottom:1px solid #334155;text-align:left}\n</style></head><body>\n<h1 style=\"text-align:center;margin-top:0\">📋 ${esc(cfg.class_name)}｜${cfg.today} 簽到</h1>\n<div class=\"wrap\">\n  <div class=\"qr\"><img src=\"${qr}\" alt=\"簽到 QR Code\"><div style=\"margin-top:8px;font-size:14px\">${esc(checkinUrl)}</div></div>\n  <div>\n    <div class=\"count\">${rows.length}</div><div style=\"color:#94a3b8;margin-bottom:16px\">人已簽到（每 5 秒自動更新）</div>\n    <table><tr><th>#</th><th>學號</th><th>姓名</th><th>時間</th></tr>${list || '<tr><td colspan=\"4\">還沒有人簽到，快拿出手機掃描 QR Code！</td></tr>'}</table>\n  </div>\n</div></body></html>`;\n\nreturn [{ json: { html } }];"
      },
      "id": "ba96789a-b44d-5aac-92a2-442f1fd4dd51",
      "name": "產生看板網頁",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
