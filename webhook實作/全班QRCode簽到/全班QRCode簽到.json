      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>課堂簽到</title><style>*{box-sizing:border-box}body{margin:0;font-family:-apple-system,'Segoe UI','Microsoft JhengHei',Arial,sans-serif;background:#f1f5f9;color:#0f172a;padding:20px}.card{background:#fff;max-width:560px;margin:24px auto;padding:28px;border-radius:20px;box-shadow:0 10px 30px rgba(15,23,42,.08)}h1{margin:0 0 8px;font-size:26px}.muted{color:#64748b}label{display:block;margin-top:16px;font-weight:600}input,textarea,button{width:100%;font-size:17px;padding:12px;margin-top:6px;border:1px solid #cbd5e1;border-radius:12px;font-family:inherit}button{background:#4f46e5;color:#fff;border:0;margin-top:22px;font-weight:700;cursor:pointer}.big{font-size:56px;text-align:center;margin:8px 0}</style></head><body><main class=\"card\"><div class=\"big\">📱</div><h1>課堂簽到</h1>\n<p class=\"muted\">填寫學號與姓名，按下簽到即可。</p>\n<form method=\"post\" action=\"/webhook/checkin-submit\">\n<label>學號<input name=\"student_id\" id=\"sid\" required autocomplete=\"off\" placeholder=\"例如 B11205001\"></label>\n<label>姓名<input name=\"name\" id=\"nm\" required autocomplete=\"off\"></label>\n<button type=\"submit\">✅ 簽到</button></form></main>\n<script>\n// 記住上次輸入的學號與姓名，下次簽到不用再打字\nconst sid=document.getElementById('sid'),nm=document.getElementById('nm');\ntry{sid.value=localStorage.getItem('sid')||'';nm.value=localStorage.getItem('nm')||'';}catch(e){}\ndocument.querySelector('form').addEventListener('submit',()=>{try{localStorage.setItem('sid',sid.value);localStorage.setItem('nm',nm.value);}catch(e){}});\n</script></body></html>",
        "options": {
