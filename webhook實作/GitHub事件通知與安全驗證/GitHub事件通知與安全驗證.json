          "renameFallbackOutput": "其他事件"
        }
      },
      "id": "aa93b9e5-5269-54f3-a794-8c9faf0b0516",
      "name": "依事件類型分流",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        460,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('收到 GitHub 事件').first().json.body;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\nreturn [{ json: {\n  subject: `✅ GitHub Webhook 設定成功：${e.repository?.full_name || ''}`,\n  html: `<h2>✅ GitHub 已經連上 n8n 了</h2><p>${esc(e.zen)}</p><p>接下來到專案按星星、開 Issue 或推送程式碼，就會收到通知。</p>`,\n} }];"
      },
      "id": "2b8ff7ae-24c7-5a60-8916-60e16ed69acc",
      "name": "整理：連線測試",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('收到 GitHub 事件').first().json.body;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\nconst branch = String(e.ref || '').replace('refs/heads/', '');\nconst commits = (e.commits || []).map(c =>\n  `<li><b>${esc(c.author?.name)}</b>：${esc(c.message.split('\\n')[0])} <a href=\"${esc(c.url)}\">查看</a></li>`).join('');\nreturn [{ json: {\n  subject: `🚀 ${e.pusher?.name} 推送了 ${(e.commits || []).length} 個 commit 到 ${e.repository?.name}/${branch}`,\n  html: `<h2>🚀 有新的程式碼推送</h2><p>專案：<b>${esc(e.repository?.full_name)}</b>　分支：<b>${esc(branch)}</b></p>\n         <ul>${commits || '<li>（沒有 commit）</li>'}</ul><p><a href=\"${esc(e.compare)}\">查看變更內容</a></p>`,\n} }];"
      },
      "id": "2226f359-95fe-55bb-ad87-4cb57cd6442c",
      "name": "整理：推送程式碼",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('收到 GitHub 事件').first().json.body;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\nconst actions = { opened: '開了新的', closed: '關閉了', reopened: '重新開啟了', edited: '編輯了' };\nconst act = actions[e.action] || e.action;\nreturn [{ json: {\n  subject: `🐛 ${e.sender?.login} ${act} Issue：${e.issue?.title}`,\n  html: `<h2>🐛 Issue 動態</h2><p><b>${esc(e.sender?.login)}</b> ${esc(act)} Issue #${e.issue?.number}</p>\n         <p style=\"font-size:18px\"><b>${esc(e.issue?.title)}</b></p>\n         <blockquote style=\"color:#555\">${esc((e.issue?.body || '').slice(0, 300))}</blockquote>\n         <p><a href=\"${esc(e.issue?.html_url)}\">到 GitHub 查看</a></p>`,\n} }];"
      },
      "id": "1ac55b8e-0d8e-50bd-8cfc-d1ef060e81dd",
      "name": "整理：Issue 動態",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('收到 GitHub 事件').first().json.body;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\nreturn [{ json: {\n  subject: `⭐ ${e.sender?.login} 幫 ${e.repository?.name} 按了星星！（目前 ${e.repository?.stargazers_count} 顆）`,\n  html: `<h2>⭐ 有人幫你按星星了！</h2><p><img src=\"${esc(e.sender?.avatar_url)}\" width=\"64\" style=\"border-radius:50%\"></p>\n         <p><b>${esc(e.sender?.login)}</b> 幫 <b>${esc(e.repository?.full_name)}</b> 按了星星</p>\n         <p>目前總共 <b>${e.repository?.stargazers_count}</b> 顆星 🎉</p>`,\n} }];"
      },
      "id": "129221ff-835a-5389-884e-811da24aa613",
      "name": "整理：按星星",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $('收到 GitHub 事件').first().json.body;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\nconst type = $('收到 GitHub 事件').first().json.headers['x-github-event'];\nreturn [{ json: {\n  subject: `📬 收到 GitHub 事件：${type}`,\n  html: `<h2>📬 收到 ${esc(type)} 事件</h2><p>這個事件還沒有專屬的處理流程，可以在 Switch 節點新增一條規則。</p>`,\n} }];"
      },
      "id": "f9471097-86a5-50c7-9638-9eb12115b635",
      "name": "整理：其他事件",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('設定').first().json.notify_email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:560px\">{{ $json.html }}</div>",
        "options": {
          "appendAttribution": false
        }
      },
