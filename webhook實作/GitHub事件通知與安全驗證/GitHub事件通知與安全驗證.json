              "value": "請改成你自己的密鑰-2026",
              "type": "string"
            },
            {
              "id": "40985ab3-5f27-5281-a7b2-deebf97ffcd7",
              "name": "notify_email",
              "value": "YOUR_EMAIL@gmail.com",
