      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>成績分析報表</title><style>*{box-sizing:border-box}body{margin:0;font-family:-apple-system,'Segoe UI','Microsoft JhengHei',Arial,sans-serif;background:#f1f5f9;color:#0f172a;padding:20px}.card{background:#fff;max-width:560px;margin:24px auto;padding:28px;border-radius:20px;box-shadow:0 10px 30px rgba(15,23,42,.08)}h1{margin:0 0 8px;font-size:26px}.muted{color:#64748b}label{display:block;margin-top:16px;font-weight:600}input,textarea,button{width:100%;font-size:17px;padding:12px;margin-top:6px;border:1px solid #cbd5e1;border-radius:12px;font-family:inherit}button{background:#4f46e5;color:#fff;border:0;margin-top:22px;font-weight:700;cursor:pointer}.big{font-size:56px;text-align:center;margin:8px 0}.card{max-width:760px}table{width:100%;border-collapse:collapse;margin-bottom:8px}td,th{padding:8px;border-bottom:1px solid #e2e8f0;text-align:left}h2{font-size:19px;margin-top:28px}</style></head><body><main class=\"card\">{{ $json.html }}<p><a href=\"/webhook/grade-upload\">⬅ 再分析一份</a></p></main></body></html>",
