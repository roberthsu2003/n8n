    {
      "parameters": {
        "jsCode": "// 自動判斷欄位：姓名欄（非數字）、科目欄（全部是數字，排除學號／座號）\nconst rows = $input.all().map(i => i.json);\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]);\nconst isNum = v => v !== '' && v !== null && v !== undefined && !isNaN(Number(v));\nconst cols = Object.keys(rows[0] || {});\nconst idLike = /學號|座號|編號|^id$|^no$/i;\nconst nameCol = cols.find(c => !rows.every(r => isNum(r[c]))) || cols[0];\nconst subjects = cols.filter(c => c !== nameCol && !idLike.test(c) && rows.length && rows.every(r => isNum(r[c])));\n\nif (!rows.length || !subjects.length) {\n  return [{ json: { ok: false, html: '<p>找不到成績欄位，請確認 CSV 第一列是欄位名稱，且成績都是數字。</p>' } }];\n}\n\nconst round1 = n => Math.round(n * 10) / 10;\nconst stats = subjects.map(s => {\n  const v = rows.map(r => Number(r[s]));\n  return { s, avg: round1(v.reduce((a, b) => a + b, 0) / v.length), max: Math.max(...v), min: Math.min(...v),\n           pass: Math.round(v.filter(x => x >= 60).length / v.length * 100) };\n});\nconst students = rows.map(r => {\n  const total = subjects.reduce((a, s) => a + Number(r[s]), 0);\n  return { name: r[nameCol], total, avg: round1(total / subjects.length), fails: subjects.filter(s => Number(r[s]) < 60) };\n}).sort((a, b) => b.total - a.total);\n\nconst bar = (pct, color) => `<div style=\"background:#e2e8f0;border-radius:8px;height:14px\"><div style=\"width:${pct}%;background:${color};height:14px;border-radius:8px\"></div></div>`;\nconst statRows = stats.map(t => `<tr><td><b>${esc(t.s)}</b></td><td>${t.avg}</td><td>${t.max}</td><td>${t.min}</td>\n  <td style=\"min-width:120px\">${bar(t.pass, t.pass >= 80 ? '#22c55e' : '#f59e0b')}<small>${t.pass}%</small></td></tr>`).join('');\nconst medal = ['🥇', '🥈', '🥉', '4', '5'];\nconst top = students.slice(0, 5).map((s, i) => `<tr><td>${medal[i]}</td><td>${esc(s.name)}</td><td>${s.total}</td><td>${s.avg}</td></tr>`).join('');\nconst fails = students.filter(s => s.fails.length);\nconst failList = fails.length\n  ? fails.map(s => `<li>${esc(s.name)}：${s.fails.map(esc).join('、')}</li>`).join('')\n  : '<li>全部及格，太棒了 🎉</li>';\n\nconst html = `<h1>📊 成績分析報表</h1><p class=\"muted\">共 ${rows.length} 位學生、${subjects.length} 個科目（${subjects.map(esc).join('、')}）</p>\n<h2>各科統計</h2><table><tr><th>科目</th><th>平均</th><th>最高</th><th>最低</th><th>及格率</th></tr>${statRows}</table>\n<h2>總分前五名</h2><table><tr><th></th><th>姓名</th><th>總分</th><th>平均</th></tr>${top}</table>\n<h2>需要補救教學（${fails.length} 人）</h2><ul>${failList}</ul>`;\nreturn [{ json: { ok: true, html } }];"
      },
      "id": "157f0eff-69e2-5903-8c35-cef38178f3ac",
      "name": "計算統計並產生報表",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        200
