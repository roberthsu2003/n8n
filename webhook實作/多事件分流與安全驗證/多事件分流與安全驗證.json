{
  "name": "多事件分流與安全驗證",
  "nodes": [
    {
      "parameters": {
        "content": "### 🛡️ Webhook 安全金鑰驗證與事件分流\n1. Webhook 接收帶有自訂 Header (`x-api-key`) 的 POST 事件\n2. IF 節點驗證金鑰是否正確（錯誤則回傳 401 Unauthorized）\n3. Switch 節點依據事件類型 (`event_type`) 進行多路分流處理\n4. 各分支處理後統一回傳結構化 JSON 結果",
        "height": 280,
        "width": 420
      },
      "id": "sticky-note-1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        140
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "secure-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-secure-events",
      "name": "安全事件 Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        360
      ],
      "webhookId": "secure-events-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-api-key",
              "leftValue": "={{ $json.headers['x-api-key'] }}",
              "rightValue": "secret-token-12345",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-auth",
      "name": "驗證 API Key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        360
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"error\",\n  \"error\": \"Unauthorized\",\n  \"message\": \"無效的 API Key，請在 Request Header 帶入正確的 x-api-key\",\n  \"timestamp\": \"{{ $now.format('yyyy-MM-dd HH:mm:ss') }}\"\n}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "respond-unauthorized",
      "name": "回傳 401 未授權",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        540
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "rule-user-signup",
                    "leftValue": "={{ $json.body.event_type }}",
                    "rightValue": "user_signup",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "新會員註冊"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "rule-order-paid",
                    "leftValue": "={{ $json.body.event_type }}",
                    "rightValue": "order_paid",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "訂單付款成功"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "switch-events",
      "name": "分流事件類型",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        660,
        280
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "signup-status",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "signup-event",
              "name": "event",
              "value": "user_signup",
              "type": "string"
            },
            {
              "id": "signup-user-id",
              "name": "user_id",
              "value": "={{ $json.body.user_id || 'U-TEMP' }}",
              "type": "string"
            },
            {
              "id": "signup-action",
              "name": "action",
              "value": "新會員歡迎信已排程發送，已指派新手引導任務",
              "type": "string"
            },
            {
              "id": "signup-processed-at",
              "name": "processed_at",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "handle-signup",
      "name": "處理新會員註冊",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        140
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "payment-status",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "payment-event",
              "name": "event",
              "value": "order_paid",
              "type": "string"
            },
            {
              "id": "payment-order-id",
              "name": "order_id",
              "value": "={{ $json.body.order_id || 'ORD-UNKNOWN' }}",
              "type": "string"
            },
            {
              "id": "payment-action",
              "name": "action",
              "value": "訂單付款驗證成功，已開立電子發票並通知倉庫撿貨",
              "type": "string"
            },
            {
              "id": "payment-processed-at",
              "name": "processed_at",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "handle-payment",
      "name": "處理訂單付款",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        280
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fallback-status",
              "name": "status",
              "value": "warning",
              "type": "string"
            },
            {
              "id": "fallback-event",
              "name": "event",
              "value": "={{ $json.body.event_type || 'undefined' }}",
              "type": "string"
            },
            {
              "id": "fallback-action",
              "name": "action",
              "value": "未定義的事件類型，已自動記錄稽核日誌 (Audit Log)",
              "type": "string"
            },
            {
              "id": "fallback-processed-at",
              "name": "processed_at",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "handle-fallback",
      "name": "處理未知事件",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-success",
      "name": "回傳處理結果",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        280
      ]
    }
  ],
  "connections": {
    "安全事件 Webhook": {
      "main": [
        [
          {
            "node": "驗證 API Key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "驗證 API Key": {
      "main": [
        [
          {
            "node": "分流事件類型",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "回傳 401 未授權",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "分流事件類型": {
      "main": [
        [
          {
            "node": "處理新會員註冊",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "處理訂單付款",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "處理未知事件",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "處理新會員註冊": {
      "main": [
        [
          {
            "node": "回傳處理結果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "處理訂單付款": {
      "main": [
        [
          {
            "node": "回傳處理結果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "處理未知事件": {
      "main": [
        [
          {
            "node": "回傳處理結果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
