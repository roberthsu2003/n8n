{
  "name": "LINE 雙向通訊與自動回覆範例",
  "nodes": [
    {
      "parameters": {
        "content": "## 📱 LINE 雙向通訊與自動回覆流程\n\n1. **Webhook 觸發器**：接收 LINE 用戶發送的訊息。\n2. **即時回傳 200 OK**：在 1 秒內回傳成功，防止伺服器重發。\n3. **解析訊息事件**：提取 `userId`、`userMessage`、`replyToken`。\n4. **判斷訊息類型**：確認為文字訊息。\n5. **準備回覆內容**：組織欲回覆的訊息字串。\n6. **呼叫 Reply API**：透過 Header Auth 憑證使用 `replyToken` 免費回覆訊息！",
        "height": 280,
        "width": 450
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        100
      ],
      "id": "sticky-note-bot-workflow",
      "name": "流程說明"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "line-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        460
      ],
      "id": "line-webhook-trigger",
      "name": "LINE Webhook 觸發器",
      "webhookId": "line-webhook-bot-id"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"ok\"}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        80,
        340
      ],
      "id": "respond-line-ok",
      "name": "即時回傳 200 OK"
    },
    {
      "parameters": {
        "jsCode": "// 解析 LINE Webhook Payload\nconst body = $input.first().json.body || {};\nconst events = body.events || [];\n\nif (events.length === 0) {\n  return [];\n}\n\nconst event = events[0];\nconst messageType = event.message?.type || '';\nconst userMessage = event.message?.text || '';\nconst replyToken = event.replyToken || '';\nconst userId = event.source?.userId || '';\nconst groupId = event.source?.groupId || '';\nconst eventType = event.type || '';\n\nreturn [{\n  json: {\n    eventType,\n    messageType,\n    userMessage,\n    replyToken,\n    userId,\n    groupId,\n    timestamp: event.timestamp\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        560
      ],
      "id": "parse-line-event",
      "name": "解析 LINE 訊息事件"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-text-message",
              "leftValue": "={{ $json.messageType }}",
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        560
      ],
      "id": "if-text-message",
      "name": "是否為文字訊息？"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "reply-text-assignment",
              "name": "replyText",
              "value": "=您好！n8n 已收到您的訊息：「{{ $json.userMessage }}」\n處理時間：{{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            },
            {
              "id": "reply-token-assignment",
              "name": "replyToken",
              "value": "={{ $json.replyToken }}",
              "type": "string"
            },
            {
              "id": "user-id-assignment",
              "name": "userId",
              "value": "={{ $json.userId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        480
      ],
      "id": "prepare-reply-message",
      "name": "準備回覆內容"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"replyToken\": \"{{ $json.replyToken }}\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"{{ $json.replyText }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        480
      ],
      "id": "http-line-reply",
      "name": "呼叫 LINE Reply API"
    }
  ],
  "connections": {
    "LINE Webhook 觸發器": {
      "main": [
        [
          {
            "node": "即時回傳 200 OK",
            "type": "main",
            "index": 0
          },
          {
            "node": "解析 LINE 訊息事件",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "解析 LINE 訊息事件": {
      "main": [
        [
          {
            "node": "是否為文字訊息？",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "是否為文字訊息？": {
      "main": [
