            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "準備回覆內容": {
      "main": [
        [
          {
            "node": "呼叫 LINE Reply API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
