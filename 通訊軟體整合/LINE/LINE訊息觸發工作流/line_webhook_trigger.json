  "nodes": [
    {
      "parameters": {
        "content": "## 📱 LINE 訊息觸發 n8n 工作流程\n\n1. **Webhook 觸發器**：接收 LINE 伺服器傳送的 Webhook 事件。\n2. **即時回傳 200 OK**：在 1 秒內回傳成功，避免 LINE 伺服器超時重複推送。\n3. **解析 LINE 訊息**：提取用戶 ID、訊息文字、ReplyToken 與事件類型。\n4. **判斷文字訊息**：分流處理文字訊息或其他事件（圖片/加入好友等）。",
        "height": 260,
        "width": 420
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -160
      ],
      "id": "602d8d73-853c-4eca-8cc3-c963c593a136",
      "name": "流程說明"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "line-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        304,
        208
      ],
      "id": "4580b68f-43cb-438f-90d8-778016ad6b90",
      "name": "LINE Webhook 觸發器",
      "webhookId": "line-webhook-trigger-id"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"ok\", \"message\": \"我已經收到你的訊息\"}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        576,
        96
      ],
      "id": "c27e7e4b-f9ac-4990-8539-e59d3bced946",
      "name": "即時回傳 200 OK"
    },
    {
      "parameters": {
        "jsCode": "// 解析 LINE Webhook Payload\nconst body = $input.first().json.body || {};\nconst events = body.events || [];\n\nif (events.length === 0) {\n  return [{\n    json: {\n      status: 'no_events',\n      note: '這通常是 LINE Webhook URL 驗證請求或無訊息事件',\n      rawBody: body,\n      receivedAt: new Date().toISOString()\n    }\n  }];\n}\n\nconst event = events[0];\nconst messageType = event.message?.type || '';\nconst userMessage = event.message?.text || '';\nconst replyToken = event.replyToken || '';\nconst userId = event.source?.userId || '';\nconst groupId = event.source?.groupId || '';\nconst eventType = event.type || '';\n\nreturn [{\n  json: {\n    status: 'ok',\n    eventType,\n    messageType,\n    userMessage,\n    replyToken,\n    userId,\n    groupId,\n    timestamp: event.timestamp,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        320
      ],
      "id": "29cf7e33-45d8-47d0-b7eb-42af6246da58",
      "name": "解析 LINE 訊息"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
