{
  "name": "Telegram 發送多媒體與文件檔案工作流",
  "nodes": [
    {
      "parameters": {
        "content": "## ✈️ 範例 4：Telegram 發送多媒體與文件檔案\n\n1. **Manual Trigger**：手動觸發執行流程。\n2. **Edit Fields (Set)**：設定目標 Chat ID、圖片網址、圖表標題與附帶說明 Caption。\n3. **Telegram Node (Send Photo)**：發送高解析度照片或監控趨勢圖。\n4. **HTTP Request**：自外部網址下載實體 CSV/PDF 報表檔案為 Binary 資料。\n5. **Telegram Node (Send Document)**：以 Binary 模式上傳並發送報表檔案至指定聊天室。",
        "height": 250,
        "width": 460
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        110
      ],
      "id": "telegram-media-note",
      "name": "流程說明"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -160,
        380
      ],
      "id": "manual-media-trigger",
      "name": "手動觸發測試"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-chat-id",
              "name": "targetChatId",
              "value": "YOUR_CHAT_ID",
              "type": "string"
            },
            {
              "id": "set-photo-url",
              "name": "photoUrl",
              "value": "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800",
              "type": "string"
            },
            {
              "id": "set-photo-caption",
              "name": "photoCaption",
              "value": "=*📈 本週業務關鍵指標 (KPI) 視覺化圖表*\n\n• 總造訪人次：`128,450` (+14.2%)\n• 訂單轉化率：`3.82%`\n• 系統可用性：`99.99%`\n\n🕒 數據更新於：_{{ $now.format('yyyy-MM-dd HH:mm') }}_",
              "type": "string"
            },
            {
              "id": "set-doc-url",
              "name": "documentUrl",
              "value": "https://raw.githubusercontent.com/roberthsu2003/n8n/main/%E5%AD%B8%E7%94%9F%E6%88%90%E7%B8%BE%E5%96%AE.csv",
              "type": "string"
            },
            {
              "id": "set-doc-caption",
              "name": "documentCaption",
              "value": "=*📄 匯出報表下載*\n\n檔案名稱：`學生成績單.csv`\n備註：內含最新學期結算成績資料。",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        80,
        380
      ],
      "id": "prepare-media-payload",
      "name": "設定多媒體與報表資料"
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $json.targetChatId }}",
        "file": "={{ $json.photoUrl }}",
        "additionalFields": {
          "caption": "={{ $json.photoCaption }}",
          "parse_mode": "Markdown"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        320,
        380
      ],
      "id": "send-telegram-photo",
      "name": "發送 Telegram 照片與圖表",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $('設定多媒體與報表資料').item.json.documentUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        380
      ],
      "id": "download-csv-file",
      "name": "下載報表檔案"
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('設定多媒體與報表資料').item.json.targetChatId }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "={{ $('設定多媒體與報表資料').item.json.documentCaption }}",
          "fileName": "學生成績單.csv"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        800,
        380
      ],
      "id": "send-telegram-document",
      "name": "發送 Telegram 文件檔案 (CSV/PDF)",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "手動觸發測試": {
      "main": [
        [
          {
            "node": "設定多媒體與報表資料",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "設定多媒體與報表資料": {
      "main": [
        [
          {
            "node": "發送 Telegram 照片與圖表",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "發送 Telegram 照片與圖表": {
      "main": [
        [
          {
            "node": "下載報表檔案",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "下載報表檔案": {
      "main": [
        [
          {
            "node": "發送 Telegram 文件檔案 (CSV/PDF)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
