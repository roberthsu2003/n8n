    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"articles\": [\n    {\n      \"id\": 1,\n      \"summary_zh\": \"OpenAI 發布新一代 GPT 模型，主打更強的推理與多步驟任務能力，並鎖定企業工作場景。官方表示新模型在複雜任務與可靠性方面有所提升，但實際效果仍需等待第三方測試與真實部署結果驗證。\",\n      \"translated_content\": \"發布內容也說明模型的主要改進方向、適用情境與目前限制，企業導入時仍應評估成本、資料安全及輸出可信度。\",\n      \"comment\": \"這項更新可能改變企業採用生成式 AI 的速度，後續應觀察實測表現、定價與安全機制能否符合宣稱。\",\n      \"importance\": 5,\n      \"tags\": [\n        \"OpenAI\",\n        \"語言模型\",\n        \"企業AI\"\n      ]\n    },\n    {\n      \"id\": 2,\n      \"summary_zh\": \"Google 調整 Gemini API 的收費結構，針對大量使用者提供新的折扣方案。此舉反映雲端 AI 服務競爭加劇，也可能改變開發團隊在不同模型與平台之間的成本評估。\",\n      \"translated_content\": \"新方案的實際影響取決於使用量、模型版本與計費級距，開發者需要重新估算長期使用成本。\",\n      \"comment\": \"定價不只是促銷，也是平台爭取開發者的重要工具，應比較整體成本而非單次呼叫價格。\",\n      \"importance\": 3,\n      \"tags\": [\n        \"Google\",\n        \"Gemini\",\n        \"API定價\"\n      ]\n    },\n    {\n      \"id\": 3,\n      \"summary_zh\": \"一項新研究提出降低大型語言模型幻覺的方法，核心是加強檢索與驗證流程，讓模型在回答前取得並核對相關證據。研究結果顯示錯誤輸出可望減少，但是否能在不同領域與實際產品中穩定運作仍待驗證。\",\n      \"translated_content\": \"研究聚焦於資訊檢索、證據比對與回答生成之間的協作方式，並討論方法的適用範圍與限制。\",\n      \"comment\": \"若能被可靠重現，這類方法有助於 AI 進入高風險場景；關鍵仍是成本、延遲與可稽核性。\",\n      \"importance\": 4,\n      \"tags\": [\n        \"AI研究\",\n        \"幻覺\",\n        \"可靠性\"\n      ]\n    }\n  ]\n}",
        "autoFix": true
      },
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1664,
        624
      ],
      "id": "8b3a0a76-9899-4d37-b926-5ce14b89847d"
    },
    {
      "parameters": {
        "jsCode": "const aiArticles = $input.all().flatMap(item => {\n  const output = item.json.output || item.json;\n  return Array.isArray(output.articles) ? output.articles : [];\n});\n\nconst originalArticles = $items(\"Prepare Data\").flatMap(item => item.json.articles || []);\nconst aiById = new Map(aiArticles.map(article => [Number(article.id), article]));\n\nconst enrichedArticles = originalArticles.map(article => {\n  const aiData = aiById.get(Number(article.id)) || {};\n  return {\n    ...article,\n    summary_zh: aiData.summary_zh || article.content,\n    translated_content: aiData.translated_content || '',\n    comment: aiData.comment || '',\n    importance: Number(aiData.importance) || 3,\n    tags: Array.isArray(aiData.tags) ? aiData.tags : []\n  };\n});\n\nenrichedArticles.sort((a, b) => b.importance - a.importance);\n\nconst byImportance = {\n  '必讀': enrichedArticles.filter(a => a.importance === 5),\n  '重要': enrichedArticles.filter(a => a.importance === 4),\n  '一般': enrichedArticles.filter(a => a.importance <= 3)\n};\n\nreturn [{\n  json: {\n    articles: enrichedArticles,\n    byImportance,\n    totalCount: enrichedArticles.length,\n    processedAt: new Date().toISOString()\n  }\n}];"
      },
      "name": "Merge AI Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        448
      ],
      "id": "02219c86-2e93-4478-9faa-33940c83d8d0"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n  const { byImportance, totalCount, processedAt } = data;\n\n  const levelConfig = {\n    '必讀': { icon: '◆', color: '#c62828', bgAccent: '#fff0f1' },\n    '重要': { icon: '◇', color: '#9a6700', bgAccent: '#fff7e0' },\n    '一般': { icon: '○', color: '#486a43', bgAccent: '#eef6ec' }\n  };\n\n  let sections = '';\n\n  ['必讀', '重要', '一般'].forEach(level => {\n    const articles = byImportance[level];\n    if (!articles?.length) return;\n\n    const { icon, color, bgAccent } = levelConfig[level];\n\n    let rows = '';\n    articles.forEach(article => {\n      const tags = article.tags.map(t =>\n        `<span style=\"display: inline-block; background-color: ${bgAccent}; color: ${color}; padding: 4px 10px; border-radius: 2px; font-size: 11px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; margin-right: 6px; margin-bottom: 4px; letter-spacing: 0.5px; text-transform: uppercase;\">${t}</span>`\n      ).join(' ');\n\n      rows += `\n        <tr>\n          <td style=\"padding: 0 0 24px 0;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td style=\"background-color: #ffffff; border-left: 3px solid ${color}; padding: 20px 24px;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td style=\"padding-bottom: 12px;\">\n                        <a href=\"${article.link}\" style=\"color: #111827; text-decoration: none; font-family: Georgia, 'Times New Roman', serif; font-size: 18px; line-height: 1.4; font-weight: normal;\">${article.title}</a>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style=\"padding-bottom: 14px;\">\n                        <p style=\"margin: 0; color: #4b5563; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6;\">${article.summary_zh}</p>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style=\"padding-bottom: 16px;\">\n                        <p style=\"margin: 0; color: #374151; font-family: Georgia, 'Times New Roman', serif; font-size: 14px; line-height: 1.8;\">${article.translated_content}</p>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style=\"padding-bottom: 12px;\">${tags}</td>\n                    </tr>\n                    <tr>\n                      <td style=\"padding-bottom: 14px;\">\n                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                          <tr>\n                            <td style=\"background-color: ${bgAccent}; border-left: 2px solid ${color}; padding: 12px 16px;\">\n                              <p style=\"margin: 0 0 6px 0; color: ${color}; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;\">編輯評論</p>\n                              <p style=\"margin: 0; color: #374151; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.6;\">${article.comment}</p>\n                            </td>\n                          </tr>\n                        </table>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <span style=\"color: #6b7280; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;\">${article.source}</span>\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n      `;\n    });\n\n    sections += `\n      <tr>\n        <td style=\"padding: 32px 0 20px 0;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n            <tr>\n              <td style=\"font-family: Georgia, 'Times New Roman', serif; font-size: 13px; color: ${color}; text-transform: uppercase; letter-spacing: 3px; padding-bottom: 8px;\">\n                ${icon} ${level}\n              </td>\n            </tr>\n            <tr>\n              <td style=\"border-bottom: 1px solid #d9dee7; padding-bottom: 0;\"></td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n      ${rows}\n    `;\n  });\n\n  const dateStr = new Date().toLocaleDateString('zh-TW', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric',\n    weekday: 'long'\n  });\n\n  const html = `\n  <!DOCTYPE html>\n  <html lang=\"zh-TW\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <title>AI 新聞日報</title>\n    <!--[if mso]>\n    <style type=\"text/css\">\n      table { border-collapse: collapse; }\n      td { font-family: Arial, sans-serif; }\n    </style>\n    <![endif]-->\n  </head>\n  <body style=\"margin: 0; padding: 0; background-color: #f3f6fa; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #f3f6fa;\">\n      <tr>\n        <td align=\"center\" style=\"padding: 40px 20px;\">\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 600px; width: 100%;\">\n\n            <!-- Accent Line -->\n            <tr>\n              <td style=\"background: linear-gradient(90deg, #c62828 0%, #9a6700 50%, #486a43 100%); height: 3px; font-size: 0; line-height: 0;\">&nbsp;</td>\n            </tr>\n\n            <!-- Header -->\n            <tr>\n              <td style=\"background-color: #f8fafc; padding: 48px 40px 40px 40px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  <tr>\n                    <td style=\"font-family: Georgia, 'Times New Roman', serif; font-size: 32px; color: #111827; letter-spacing: -0.5px; padding-bottom: 8px;\">\n                      AI 新聞日報\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 2px;\">\n                      ${dateStr}\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding-top: 24px;\">\n                      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                        <tr>\n                          <td style=\"background-color: #ffffff; padding: 12px 20px; border-radius: 2px;\">\n                            <span style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #4b5563;\">\n                              本期收錄 <strong style=\"color: #111827;\">${totalCount}</strong> 篇精選文章\n                            </span>\n                          </td>\n                        </tr>\n                      </table>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- Content -->\n            <tr>\n              <td style=\"background-color: #f8fafc; padding: 0 40px 40px 40px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  ${sections}\n                </table>\n              </td>\n            </tr>\n\n            <!-- Footer -->\n            <tr>\n              <td style=\"background-color: #eef2f6; padding: 32px 40px; border-top: 1px solid #d9dee7;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  <tr>\n                    <td align=\"center\" style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 1.5px;\">\n                      Curated by n8n × OpenAI\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n  </html>\n  `;\n\n  return [{\n    json: {\n      html,\n      subject: `AI 新聞日報 — ${new Date().toLocaleDateString('zh-TW', { month: 'long', day: 'numeric' })}`,\n      totalCount\n    }\n  }];"
      },
