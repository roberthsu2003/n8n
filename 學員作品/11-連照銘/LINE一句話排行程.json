      "parameters": {
        "jsCode": "const title = $json.summary ?? $json.title ?? '行程';\nconst start = $json.start?.dateTime ?? $json.start?.date ?? $json.start_datetime ?? '';\nconst end = $json.end?.dateTime ?? $json.end?.date ?? $json.end_datetime ?? '';\nconst location = $json.location ?? '';\n\nconst formatDateTime = (value) => {\n  if (!value) return '';\n  const d = new Date(value);\n  if (Number.isNaN(d.getTime())) return String(value);\n  return d.toLocaleString('zh-TW', {\n    timeZone: 'Asia/Taipei',\n    year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: '2-digit', minute: '2-digit', hour12: false\n  });\n};\n\nlet text = `✅ 行事曆已建立\\n行程：${title}`;\nif (start) text += `\\n開始：${formatDateTime(start)}`;\nif (end) text += `\\n結束：${formatDateTime(end)}`;\nif (location) text += `\\n地點：${location}`;\n\nreturn [{ json: { ...$json, line_reply: text } }];"
      },
