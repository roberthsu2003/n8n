    {
      "parameters": {
        "promptType": "define",
        "text": "={{ '你是課程顧問。使用者傳來的訊息語氣中立（例如一般詢問、單純陳述事實，沒有明顯的情緒起伏）。請用清楚、專業且友善的語氣直接回答問題，不需要過度熱情或刑意安撫。如果問題涉及費用、課程內容等細節但資料不足，請說明需要進一步確認的地方，不要自行捐造。回答後可視情況簡短提供下一步（例如留下聯絡方式），但不要勉強推銷。\\n\\n使用者訊息：' + $('Webhook').item.json.body.events[0].message.text }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
