    {
      "parameters": {
        "jsCode": "// FIX: 保留 +08:00 時區，避免 end.toISOString() 變成 UTC 導致 LINE 顯示差 8 小時\nconst data = $json.output || $json;\n\nif (!data.start_datetime) {\n  throw new Error('Information Extractor 沒有回傳 start_datetime，原始資料: ' + JSON.stringify(data));\n}\n\nconst start = new Date(data.start_datetime);\nif (isNaN(start.getTime())) {\n  throw new Error('start_datetime 無法解析: ' + data.start_datetime);\n}\n\nconst mins = Number(data.duration_minutes ?? 60) || 60;\nconst end = new Date(start.getTime() + mins * 60000);\n\n// 轉成 Asia/Taipei (+08:00) 的 ISO 格式，例如 2026-09-16T11:00:00+08:00\nfunction toTaipeiISO(d) {\n  const pad = (n) => String(n).padStart(2, '0');\n  const t = new Date(d.getTime() + 8 * 60 * 60 * 1000);\n  return `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}-${pad(t.getUTCDate())}T${pad(t.getUTCHours())}:${pad(t.getUTCMinutes())}:${pad(t.getUTCSeconds())}+08:00`;\n}\n\n// start 也正規化成 +08:00，避免模型偶爾回傳 Z 或無時區\nconst title = (data.title || '未命名行程').trim();\nconst location = (data.location || '').trim();\nconst is_all_day = Boolean(data.is_all_day ?? false);\n\nreturn [{\n  json: {\n    title,\n    start_datetime: toTaipeiISO(start),\n    end_datetime: toTaipeiISO(end),\n    duration_minutes: mins,\n    location,\n    is_all_day\n  }\n}];"
      },
