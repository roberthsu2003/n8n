      "id": "65690e87-6c43-4da1-992d-0a08c2985e6b",
      "name": "下載 GetBible 繁體和合本",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        2064
      ],
      "notes": "GetBible API v2：CUT / Union Traditional 繁體和合本。"
    },
    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nlet books;\nif (Array.isArray(src)) books = src;\nelse if (Array.isArray(src.books)) books = src.books;\nelse if (src.books && typeof src.books === 'object') books = Object.values(src.books);\nelse if (src.chapters || src.name || src.book_name || src.book) books = [src];\nelse books = Object.values(src || {}).filter(v => v && typeof v === 'object' && (v.chapters || v.name || v.book_name));\n\nconst out=[];\nfor (const book of books) {\n  const bookName = String(book.name || book.book_name || book.book || '').replace(/\\uFEFF/g,'').trim();\n  if (!['創世記','創世紀','出埃及記'].includes(bookName)) continue;\n  const chapters = Array.isArray(book.chapters) ? book.chapters : Object.values(book.chapters || {});\n  for (const chapter of chapters) {\n    const chapterNo = Number(chapter.chapter ?? chapter.chapter_nr ?? chapter.nr ?? 0);\n    const verses = Array.isArray(chapter.verses) ? chapter.verses : Object.values(chapter.verses || {});\n    for (let i=0;i<verses.length;i+=10) {\n      const group=verses.slice(i,i+10);\n      if(!group.length) continue;\n      const start=Number(group[0].verse ?? group[0].verse_nr ?? i+1);\n      const end=Number(group[group.length-1].verse ?? group[group.length-1].verse_nr ?? i+group.length);\n      const content=group.map((v,j)=>`${Number(v.verse ?? v.verse_nr ?? start+j)} ${String(v.text ?? v.verse_text ?? '').trim()}`).join('\\n');\n      if(!content.trim()) continue;\n      const reference=`${bookName} ${chapterNo}:${start}-${end}`;\n      const isGenesis=['創世記','創世紀'].includes(bookName);\n      out.push({json:{text:`資料來源：繁體和合本（GetBible CUT）\\nreference：${reference}\\nsource_id：GETBIBLE_CUT\\nsource_url：https://api.getbible.net/v2/cut/${isGenesis?'1':'2'}.json\\n適用範圍：僅限創世記與出埃及記經文\\n內容：${content}`,title:'繁體和合本（GetBible CUT）',source_id:'GETBIBLE_CUT',reference,category:'bible',clear:isGenesis && out.length===0}});\n    }\n  }\n}\nif(!out.length) throw new Error('GetBible 單卷回傳格式未解析出創世記或出埃及記經文，請檢查 API 結構。');\nreturn out;"
      },
