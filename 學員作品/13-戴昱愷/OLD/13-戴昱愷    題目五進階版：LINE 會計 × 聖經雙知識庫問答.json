      "notes": "GetBible API v2：CUT 第2卷／出埃及記。"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const q=String($json.question??'').replace(/創世紀/g,'創世記').trim();\nconst re=/(創世記|出埃及記|利未記|民數記|申命記)\\s*(\\d+)\\s*[:：]\\s*(\\d+)/g;\nconst bookNos={'創世記':1,'出埃及記':2,'利未記':3,'民數記':4,'申命記':5};\nconst refs=[]; let m;\nwhile((m=re.exec(q))!==null){refs.push({book:m[1],chapter:Number(m[2]),verse:Number(m[3]),bookNo:bookNos[m[1]]});}\nreturn {json:{...$json,exactBibleRef:refs.length>0,bibleRefs:refs,bibleBook:refs[0]?.book??'',bibleChapter:refs[0]?.chapter??null,bibleVerse:refs[0]?.verse??null,bibleBookNo:refs[0]?.bookNo??null}};"
      },
