    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 建庫成功的判定不應依賴特定上游欄位名稱；只要本節點收到資料，就代表前一個建庫節點已完成並有輸出。\nif (!items.length) {\n  throw new Error('聖經建庫沒有收到任何上游輸出');\n}\n\nreturn items.map((item, index) => ({\n  json: {\n    ...item.json,\n    bibleBuildVerified: true,\n    bibleBuildVerifiedAt: new Date().toISOString(),\n    bibleBuildItemIndex: index + 1,\n    bibleBuildItemCount: items.length\n  },\n  pairedItem: { item: index }\n}));"
