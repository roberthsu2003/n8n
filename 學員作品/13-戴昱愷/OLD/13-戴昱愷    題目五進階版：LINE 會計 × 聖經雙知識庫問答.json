      "id": "7775abf0-c5a8-4389-827c-a4199c7150e8",
      "name": "下載 GetBible 出埃及記",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        2224
