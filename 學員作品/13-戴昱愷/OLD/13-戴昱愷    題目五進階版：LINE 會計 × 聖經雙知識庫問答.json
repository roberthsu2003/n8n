    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const req=$('聖經 解析章節').item.json;\nconst refs=Array.isArray(req.bibleRefs)&&req.bibleRefs.length?req.bibleRefs:[{book:req.bibleBook,chapter:req.bibleChapter,verse:req.bibleVerse,bookNo:req.bibleBookNo}];\nconst base='https://api.getbible.net/v2/cut/';\nconst norm=s=>String(s??'').replace(/創世紀/g,'創世記').replace(/\\uFEFF/g,'').trim();\nfunction booksOf(src){if(Array.isArray(src))return src;if(Array.isArray(src?.books))return src.books;if(src?.books&&typeof src.books==='object')return Object.values(src.books);if(src?.chapters||src?.name||src?.book_name||src?.book)return [src];return Object.values(src||{}).filter(v=>v&&typeof v==='object');}\nasync function loadBook(bookNo){if(bookNo===1)return $json;const r=await this.helpers.httpRequest({method:'GET',url:base+bookNo+'.json',json:true,timeout:60000});return r;}\nconst cache=new Map([[1,$json]]); const answers=[];\nfor(const r of refs){let src=cache.get(r.bookNo);if(!src){src=await loadBook.call(this,r.bookNo);cache.set(r.bookNo,src);}const books=booksOf(src);const book=books.find(b=>norm(b.name||b.book_name||b.book)===r.book);if(!book){answers.push(`${r.book} ${r.chapter}:${r.verse}\\n目前提供的資料中沒有這項資訊`);continue;}const chapters=Array.isArray(book.chapters)?book.chapters:Object.values(book.chapters||{});const ch=chapters.find(c=>Number(c.chapter??c.chapter_nr??c.nr)===r.chapter);const verses=ch?(Array.isArray(ch.verses)?ch.verses:Object.values(ch.verses||{})):[];const v=verses.find(x=>Number(x.verse??x.verse_nr)===r.verse);if(!v){answers.push(`${r.book} ${r.chapter}:${r.verse}\\n目前提供的資料中沒有這項資訊`);continue;}answers.push(`${r.book} ${r.chapter}:${r.verse}\\n${String(v.text??v.verse_text??'').trim()}`);}\nreturn {json:{...req,response:`${answers.join('\\n\\n')}\\n\\n資料來源：繁體和合本（GetBible CUT）\\nreference：${refs.map(r=>`${r.book} ${r.chapter}:${r.verse}`).join('、')}`}};"
      },
