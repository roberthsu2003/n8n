    {
      "parameters": {
        "code": {
          "supplyData": {
            "code": "const original = await this.getInputConnectionData('ai_vectorStore', 0);\nconst allowed = doc => /^創世[記紀]\\s+\\d+:/.test(String(doc?.metadata?.reference || '').replace(/\\uFEFF/g, '').trim());\nconst filtered = Object.create(Object.getPrototypeOf(original));\nObject.assign(filtered, original);\nfiltered.similaritySearch = async (...args) => (await original.similaritySearch(...args)).filter(allowed);\nfiltered.similaritySearchWithScore = async (...args) => (await original.similaritySearchWithScore(...args)).filter(pair => allowed(pair[0]));\nreturn filtered;"
          }
