      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json.error || !String($json.response ?? '').trim()\n  ? '目前暫時無法回答，請稍後再傳一次訊息。謝謝你的耐心等候。'\n  : $json.response;\n\nlet text = String(response)\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/^\\s*#{1,6}\\s*/gm, '')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '$1')\n  .replace(/__(.*?)__/g, '$1')\n  .replace(/~~(.*?)~~/g, '$1')\n  .replace(/`([^`]+)`/g, '$1')\n  .replace(/(?<!\\w)\\*([^*\\n]+)\\*(?!\\w)/g, '$1')\n  .replace(/(?<!\\w)_([^_\\n]+)_(?!\\w)/g, '$1')\n  .replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, '$1（$2）')\n  .replace(/^\\s*[-*+]\\s+/gm, '• ')\n  .replace(/^\\s*>\\s?/gm, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nif(text.includes('目前提供的資料中沒有這項資訊')) text='目前提供的資料中沒有這項資訊';\nconst event=$('逐則處理訊息').item.json; return {json:{...event,line_reply:text.slice(0,4500)}};"
      },
