            "code": "const embedding = await this.getInputConnectionData('ai_embedding', 0);\nconst valid = v => Array.isArray(v) && v.length === 3072 && v.every(Number.isFinite) && v.some(x => x !== 0);\nreturn { async embedDocuments(texts) { for (let attempt=0; attempt<4; attempt++) { const vectors=await embedding.embedDocuments(texts); if(vectors.length===texts.length && vectors.every(valid)) return vectors; if(attempt<3) await new Promise(resolve=>setTimeout(resolve,65000)); } throw new Error('Gemini 回傳空白或無效向量，已停止寫入；請稍後重新建庫。'); }, async embedQuery(text) { const vector=await embedding.embedQuery(text); if(!valid(vector)) throw new Error('Gemini 查詢向量無效'); return vector; } };"
