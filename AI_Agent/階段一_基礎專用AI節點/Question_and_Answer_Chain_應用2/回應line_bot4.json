    {
      "parameters": {
        "jsCode": "const response = $json.response ?? '';\n\nlet text = String(response)\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/^\\s*#{1,6}\\s*/gm, '')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '$1')\n  .replace(/__(.*?)__/g, '$1')\n  .replace(/~~(.*?)~~/g, '$1')\n  .replace(/`([^`]+)`/g, '$1')\n  .replace(/(?<!\\w)\\*([^*\\n]+)\\*(?!\\w)/g, '$1')\n  .replace(/(?<!\\w)_([^_\\n]+)_(?!\\w)/g, '$1')\n  .replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, '$1（$2）')\n  .replace(/^\\s*[-*+]\\s+/gm, '• ')\n  .replace(/^\\s*>\\s?/gm, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [{ json: { ...$json, line_reply: text } }];"
      },
