      "id": "ce07016b-f8d5-456b-8b22-a9018e2fb9fd",
      "name": "計算分數"
    },
    {
      "parameters": {
        "jsCode": "const ranked = items\n  .map((item, index) => ({ item, index, average: Number(item.json['平均']) }))\n  .sort((a, b) => {\n    const aAverage = Number.isFinite(a.average) ? a.average : -Infinity;\n    const bAverage = Number.isFinite(b.average) ? b.average : -Infinity;\n    return bAverage - aAverage || a.index - b.index;\n  });\n\nlet previousAverage;\nlet previousRank = 0;\n\nreturn ranked.map((entry, index) => {\n  const average = entry.average;\n  if (average !== previousAverage) {\n    previousRank = index + 1;\n    previousAverage = average;\n  }\n\n  return {\n    json: {\n      ...entry.item.json,\n      '排名': previousRank,\n    },\n    pairedItem: { item: entry.index },\n  };\n});"
      },
